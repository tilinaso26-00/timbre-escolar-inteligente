{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timbre Escolar Inteligente",
  "version": "1.0.0",
  "identifier": "com.timbre-escolar.inteligente",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "title": "Timbre Escolar Inteligente",
      "label": "main",
      "url": "/",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 768,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "titleBarStyle": "visible",
      "hiddenTitle": false,
      "visible": true,
      "resizable": true,
      "decorations": true,
      "transparent": false,
      "alwaysOnTop": false,
      "contentProtection": false,
      "focus": true,
      "hiddenTitle": false,
      "maximizable": true,
      "minimizable": true,
      "closable": true
    }],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://* wss://* http://* https://*; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
    }
  },
  "app": {
    "windows": [{
      "title": "Timbre Escolar Inteligente",
      "label": "main",
      "url": "/",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 768,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "titleBarStyle": "visible",
      "hiddenTitle": false,
      "visible": true,
      "resizable": true,
      "decorations": true,
      "transparent": false,
      "alwaysOnTop": false,
      "contentProtection": false,
      "focus": true,
      "hiddenTitle": false,
      "maximizable": true,
      "minimizable": true,
      "closable": true
    }],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://* wss://* http://* https://*; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "es-ES",
        "template": "templates/wix/main.wxs"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": [],
        "conflicts": [],
        "provides": [],
        "replaces": [],
        "section": "utils",
        "priority": "optional"
      }
    }
  },
  "plugins": {
    "fs": {
      "all": true,
      "scope": {
        "allowed": ["$APPDATA/*", "$APPDATA/timbre-escolar/*", "$HOME/*", "$DOCUMENTS/*", "$DOWNLOADS/*"]
      }
    },
    "shell": {
      "all": false,
      "open": true,
      "scope": {
        "allow": ["open", "https://*", "http://*"]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "dialog": true,
      "pubkey": ""
    }
  }